SERVER_PORT=8085
DB_HOST=payment-postgres
DB_PORT=5432
DB_NAME=medisync_payment
DB_USERNAME=payment_user
DB_PASSWORD=payment_pass
EUREKA_URL=http://eureka-server:8761/eureka
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Stripe — get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Stripe webhook secret — get from Stripe CLI (see setup guide below)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

STRIPE_CURRENCY=USD
JWT_SECRET=same_jwt_secret_as_all_other_services_min_32_chars
SERVICE_SECRET=internal_service_secret_key
